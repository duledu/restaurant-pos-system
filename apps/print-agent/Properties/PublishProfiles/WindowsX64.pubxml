<!-- Faza 2C konsolidacija — ovaj profil više nije ono što stvarno pravi
     installer/TableCorePrintAgent.iss. Stvaran objavljeni artefakt dolazi
     ISKLJUČIVO iz `dotnet publish -c Release` (bez -p:PublishProfile), koji
     čita PropertyGroup Condition="'$(Configuration)'=='Release'" direktno
     iz TableCore.PrintAgent.csproj — JEDAN izvor istine. Ovaj fajl je
     ažuriran da se SLAŽE sa tim (single-file, ne folder) umesto da ostane
     tiho pogrešan ako ga neko ipak eksplicitno pozove. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
</Project>
