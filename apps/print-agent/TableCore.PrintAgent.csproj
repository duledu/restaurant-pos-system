<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Faza 2C follow-up — Microsoft.NET.Sdk.Web podrazumeva konzolni
         (Exe) subsistem, koji Windows uvek prati sopstvenim (crnim) CMD
         prozorom pri svakom pokretanju EXE-a, bez obzira da li kod ijednom
         pozove Console.WriteLine — upravo prijavljen bug ("crni CMD prozor
         iza WinForms Setup-a"). WinExe (GUI subsistem) NIKAD ne dobija taj
         prozor. Program.cs kompenzuje za CLI/self-test upotrebu (npr. "dotnet
         run" sa self-test opcijom) eksplicitnim AttachConsole(ATTACH_PARENT_PROCESS)
         pre bilo kog Console.WriteLine poziva — standardan .NET obrazac za
         hibridni GUI+CLI alat, ne utiče na Windows servis (Session 0, nema
         konzolu ni pre ni posle ove izmene). -->
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- BUG #7 (print-agent version source, 2026-09-19) — SINGLE AUTHORITATIVE
         VERSION SOURCE for the Print Agent. Everything that says "what
         version is this binary?" derives from this <Version>:
           - AssemblyInformationalVersionAttribute (read at runtime by
             apps/print-agent/AgentRunner.cs:AgentVersion.Current, with the
             optional SourceLink `+<sha>` suffix stripped to the user-facing
             label).
           - Win32 VERSIONINFO ProductVersion / FileVersion (visible in
             Windows Properties -> Details).
         The installer (apps/print-agent/installer/build-preprod.ps1) is
         REQUIRED to read THIS exact value and pass it to ISCC as
         /DAgentVersion=...; .iss has no independent default and fails to
         compile without that flag. Mismatch between this value and the
         requested installer version fails the build before any artifact
         is packaged. -->
    <Version>1.0.0-rc.2</Version>
    <!-- Never package workstation config, local SDKs, or prior publish/test output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;.tools/**;agent.local.json</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Faza 2C, sekcija 2 — samostalan (self-contained) win-x64 objavljeni
       paket, BEZ posebne .NET instalacije na ciljnom računaru. Namerno
       uslovljeno na Release konfiguraciju (ne osnovni PropertyGroup iznad):
       svakodnevni `dotnet build`/`dotnet run` (self-test i sl.) u Debug-u ostaje
       brz, framework-dependent (deli već instaliran .NET 8 SDK runtime na
       OVOM razvojnom računaru); STVARAN objavljeni artefakt za installer
       (installer/) uvek dolazi iz `dotnet publish -c Release`. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Microsoft.Data.Sqlite nosi izvornu (native) SQLitePCLRaw biblioteku
         koja MORA moći da se raspakuje pored jednog EXE-a pri pokretanju —
         bez ovoga bi single-file objavljivanje tiho pokvarilo AgentDatabase.cs
         (SQLite) na ciljnoj mašini, iako lokalni build/self-test to nikad ne
         bi otkrio (Debug/dotnet run ne koristi ovaj put). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Faza 2A — CredentialStore.cs (DPAPI). Ne deo osnovnog net8.0-windows
         BCL-a iako umotava Windows-only API; zvaničan, Microsoft-objavljen
         paket. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Faza 2B — AgentDatabase.cs: lagano, pouzdano, fajl-bazirano trajno
         lokalno stanje pokušaja štampe (zamenjuje in-memory skup iz Faze 1).
         Samo ADO.NET provajder, NE EF Core — namerno najmanji dovoljan alat. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Faza 2C — AgentService.cs: hostuje AgentRunner.Run kao Windows
         servis (Generic Host + SCM integracija), zvaničan Microsoft paket. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
</Project>
