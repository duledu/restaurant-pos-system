# Dependencies
node_modules/
.pnp/
.pnp.js

# Next.js build output
.next/
out/

# Build artifacts (ostali paketi/alati)
dist/
build/

# Test coverage
coverage/

# Environment fajlovi — NIKAD ne commitovati stvarne tajne
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# Prisma generated client
.prisma/client

# Vercel
.vercel

# Lokalna embedded Postgres baza (scripts/dev-local.mjs, scripts/db-local.mjs)
.local-postgres-data/

# Lokalna embedded TEST Postgres baza (scripts/run-integration-tests.mjs) —
# potpuno odvojena od DEV baze iznad, vidi docs/database-safety.md
.local-postgres-data-test/

# Stale .next cache directories captured during manual renames; safe to
# recreate from `next build`. Ignored to keep working tree clean.
.next-stale-*/

# Repros removed out of tests/scripts during debugging; kept locally for
# reference but never tracked (they intentionally have non-.test.ts names
# that vitest wouldn't pick up anyway, but better to make the policy
# explicit).
/_repro_removed/

# Database backups (scripts/db-backup.mjs) — contain real business data,
# NEVER commit. See docs/database-backup-recovery.md.
/backups/

# Editor
.vscode/
.idea/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Logovi
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Privremeni fajlovi
*.tmp
*.temp

# TypeScript
*.tsbuildinfo
next-env.d.ts
.env*
