# ══════════════════════════════════════════════════════════════════════
# Restaurant Control System — environment promenljive
#
# Kopiraj ovaj fajl u .env.local i popuni stvarne vrednosti:
#   cp .env.example .env.local
#
# .env.local NIKADA ne sme biti commitovan (već je u .gitignore).
# ══════════════════════════════════════════════════════════════════════

# ── Aplikacija ──────────────────────────────────────────────────────────
NODE_ENV=development

# Javni URL aplikacije (koristi se za apsolutne URL-ove u emailu/notifikacijama).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Baza podataka (Neon PostgreSQL) ────────────────────────────────────
#
# Neon pruža DVA tipa connection stringa (vidljivi u Neon konzoli,
# kartica "Connection Details"):
#
#   1. POOLED  — host završava na "-pooler" i sadrži "pgbouncer=true"
#                Koristi se za RUNTIME (PrismaClient u aplikaciji).
#                Vercel serverless funkcije otvaraju puno kratkoživećih
#                konekcija — pooler ih reciklira i sprečava prekoračenje limita.
#
#   2. DIRECT  — standardni host bez "-pooler"
#                Koristi se ISKLJUČIVO za `prisma migrate deploy`.
#                `prisma migrate deploy` ne radi preko PgBouncera jer
#                zahteva extended protocol koji pooler ne podržava.
#
# Lokalni razvoj: oba mogu biti isti (direktni) string jer nema
# serverless okruženja. Vercel produkcija: svakako koristi oba.
#
# DATABASE_URL  = POOLED connection string (runtime)
# DIRECT_URL    = DIRECT connection string (migracije)

DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dbname?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# ── Autentifikacija ─────────────────────────────────────────────────────
# Tajni ključ za potpisivanje session JWT-a (packages/auth/session.ts).
# MORA biti jak i jedinstven za svako okruženje. Generiši komandom:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ili:
#   openssl rand -base64 32
# Minimalna dužina: 32 karaktera. Nikad ne kopirati ovu vrednost u produkciju.
AUTH_SECRET="GENERATE-A-STRONG-RANDOM-SECRET-MIN-32-CHARS"

# AES-256-GCM ključ za šifrovano čuvanje PIN-a (Admin Otkrivanje PIN-a).
# MORA biti tačno 64 hex karaktera (32 bajta). Generiši komandom:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ako nije postavljen, PIN otkrivanje nije dostupno (sve ostalo radi normalno).
# Nikad ne menjati vrednost u produkciji — postojeći enkriptovani PIN-ovi postaju nečitljivi.
# PIN_ENCRYPTION_KEY="GENERATE-64-HEX-CHARS-32-BYTES-KEY"

# ── Test baza (automatizovani integration testovi) ─────────────────────
#
# NE POSTAVLJAJ OVO OVDE. `npm run test:integration` sam podiže i obeležava
# izolovanu, disposable lokalnu test bazu (port 55433, baza "rcs_test") —
# NIKAD ne koristi DATABASE_URL iznad kao fallback za testove (vidi
# docs/database-safety.md — upravo je ta zamena obrisala dev podatke u
# avgustu 2026). Postavi TEST_DATABASE_URL ovde SAMO ako namerno želiš da
# testovi rade protiv nečeg drugog (npr. posebna Neon "test" grana) — u tom
# slučaju prvo pokreni `npm run test:db:mark` jednokratno.
# TEST_DATABASE_URL=

# ── QZ Tray potpisivanje (P0.16 — OPCIONO, tiha štampa radi i bez ovoga) ─
# Bez ovoga: QZ Tray sam prikazuje "nepouzdano, dozvoli jednom?" prompt na
# svakoj konekciji/prvom printu umesto potpuno tihe štampe — QZ direktna
# štampa i dalje RADI (nije Chrome print dijalog, samo QZ-ov sopstveni
# jednokratni prompt) dok se ovo ne podesi. QZ_CERTIFICATE = javni sertifikat
# (PEM string) koji QZ Tray treba da veruje; QZ_PRIVATE_KEY = odgovarajući
# privatni ključ, ISKLJUČIVO server-side (apps/web/app/api/print/qz-sign),
# NIKAD u klijentskom bundle-u. Dobija se kupovinom sertifikata od QZ
# Industries (buy.qz.io) ILI generisanjem sopstvenog root sertifikata koji
# QZ Tray instalacija na svakom kuhinjskom računaru mora eksplicitno da
# veruje (vidi qz.io/docs/generate-certificate) — ne izmišljati/generisati
# ovde bez stvarnog provisioning koraka.
# QZ_CERTIFICATE=
# QZ_PRIVATE_KEY=

# ── Redis keš (P0/perf — OPCIONO, aplikacija radi ispravno bez njega) ──
# Bez ovoga (ili u lokalnom razvoju): svaki cache poziv se ponaša kao no-op
# i sve ide direktno na PostgreSQL — TAČNO ista funkcionalnost kao pre
# uvođenja keša, samo bez ubrzanja. Upstash REST klijent (ne TCP) — jedini
# tip Redis klijenta koji ima smisla u Vercel serverless okruženju (vidi
# packages/domain/cache/cache-client.ts). NIKAD ne postaviti u ovom fajlu —
# stvarne vrednosti idu SAMO u Vercel Environment Variables (Production/
# Preview/Development), ovde su samo imena promenljivih.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Fiskalizacija (PRIPREMA ARHITEKTURE, još ne aktivna) ────────────────
# Podrazumevano i trenutno JEDINO stanje: isključeno. Kad je isključeno
# (ne postavljeno, ili bilo šta osim "true"): nema fiskalnih API poziva,
# nema fiskalnog čekanja, nema fiskalne greške — naplata i TableCore
# nefiskalni radni nalog rade identično kao danas. Vidi
# packages/domain/fiscalization/ — nijedan pravi provajder još nije
# povezan, ne postavljati na "true" dok taj rad ne bude završen.
# FISCALIZATION_ENABLED=false

# ── Seed skripta za uvoz menija (packages/db/prisma/seed-menu.ts) ──────
# Potrebno SAMO kad se ručno pokreće seed-menu.ts.
# Vrednost dobijaš iz izlaza `npm run db:seed`
# (ispisuje "restaurantId za seed-menu.ts: <id>").
# RESTAURANT_ID=
