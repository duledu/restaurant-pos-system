// Restaurant Control System — Prisma Schema
// FAZA 1: Project foundation — Tenant, Restaurant, Location, User/Employee,
// RBAC, Device, AuditLog.
//
// NAMERNO OGRANIČENO NA FAZU 1: Menu/Table/Order/Inventory/... modeli se
// dodaju u narednim fazama (vidi docs/01-RCS-Plan-v2-MVP.md, tačka 9 —
// aditivne migracije, bez menjanja ovde definisanih tabela).
//
// Odluke donete pri pregledu skice iz plana (tačka 6 zahteva):
// - Referential actions: FK ka Restaurant/Tenant/Location su RESTRICT
//   (podrazumevano) — brisanje restorana/lokacije sa postojećim zaposlenima
//   ili uređajima mora biti eksplicitna, svesna operacija, ne kaskadno
//   brisanje poslovne istorije. Join tabele (EmployeeLocation, RolePermission,
//   EmployeeRole) koriste CASCADE jer je njihov jedini smisao veza — brisanje
//   Employee-a ili Role-a treba da povuče i te veze.
// - Employee.userId je nullable + onDelete: SetNull: zaposleni (npr. konobar
//   sa samo PIN pristupom) ne mora imati User (email/lozinka) nalog, i
//   brisanje login naloga ne sme obrisati istoriju zaposlenog.
// - UserRole iz skice preimenovan u EmployeeRole: veza je zapravo
//   Employee<->Role, ne User<->Role (User je samo login identitet); tačan
//   naziv sprečava buduću zabunu.
// - Nema soft-delete (deletedAt) na ovim entitetima — koriste se eksplicitni
//   status enumi (RestaurantStatus, EmployeeStatus...), u skladu sa pravilom
//   "soft delete samo gde je prikladno" iz v1 plana.
// - Email se čuva već normalizovan (lowercase) na aplikativnom sloju —
//   Postgres @unique je case-sensitive; ne uvodimo citext ekstenziju za MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANT / RESTAURANT / LOCATION
// ─────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  restaurants Restaurant[]

  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Restaurant {
  id        String           @id @default(uuid())
  tenantId  String
  name      String
  legalName String?
  timezone  String           @default("Europe/Belgrade")
  currency  String           @default("RSD")
  status    RestaurantStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  createdBy String?

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  locations           Location[]
  employees           Employee[]
  roles               Role[]
  devices             Device[]
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  floors              Floor[]
  shifts              Shift[]
  orders              Order[]
  settings            RestaurantSettings?
  inventoryItems      InventoryItem[]
  modifierGroups      ModifierGroup[]
  ingredients         Ingredient[]
  ingredientStocks    IngredientStock[]
  inventoryCategories InventoryCategory[]

  @@index([tenantId])
  @@index([status])
  @@map("restaurants")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Location {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id])
  devices           Device[]
  employeeLocations EmployeeLocation[]
  floors            Floor[]
  shifts            Shift[]
  orders            Order[]
  inventoryItems    InventoryItem[]
  ingredientStocks  IngredientStock[]

  @@index([restaurantId])
  @@map("locations")
}

// ─────────────────────────────────────────────────────────────────────────
// USERS / EMPLOYEES / RBAC
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  // username je primarni identifikator za prijavu (zamenio email u loginSchema).
  // email ostaje u bazi radi kompatibilnosti; za stare naloge username = email.
  username     String   @unique
  email        String?  @unique
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee?

  @@map("users")
}

// Persistent email-login throttle state. The key is a SHA-256 digest of the
// normalized email, so this table does not become another store of account
// identifiers. Database persistence makes throttling consistent across
// serverless instances.
model LoginThrottle {
  key            String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([lockedUntil])
  @@map("login_throttles")
}

model Employee {
  id                String         @id @default(uuid())
  restaurantId      String
  userId            String?        @unique
  firstName         String
  lastName          String
  pinHash           String?
  // AES-256-GCM šifrovan PIN za admin otkrivanje (ključ u PIN_ENCRYPTION_KEY env).
  // Null = PIN nije postavljen ili nije šifrovan (stariji red pre migracije).
  encryptedPin      String?
  // Kada false, zaposleni se ne prikazuje u imeniku niti može da se prijavi PIN-om.
  pinLoginEnabled   Boolean        @default(true)
  failedPinAttempts Int            @default(0)
  pinLockedUntil    DateTime?
  status            EmployeeStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdBy         String?

  restaurant     Restaurant         @relation(fields: [restaurantId], references: [id])
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  roles          EmployeeRole[]
  locations      EmployeeLocation[]
  personalDevice Device?

  @@index([restaurantId])
  @@index([status])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

// M:N Employee <-> Location (na kojim lokacijama zaposleni sme da radi).
model EmployeeLocation {
  employeeId String
  locationId String
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([employeeId, locationId])
  @@index([locationId])
  @@map("employee_locations")
}

model Role {
  id           String   @id @default(uuid())
  restaurantId String
  name         String // OWNER, ADMIN, MANAGER, WAITER, KITCHEN, BAR, INVENTORY_MANAGER, ili custom
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id])
  permissions RolePermission[]
  employees   EmployeeRole[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // npr. "order.void", "inventory.adjust", "price.edit"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Employee <-> Role (u skici je bila nazvana "UserRole" — ispravljeno,
// vidi napomenu na vrhu fajla).
model EmployeeRole {
  employeeId String
  roleId     String
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
}

model Device {
  id           String     @id @default(uuid())
  restaurantId String
  locationId   String?
  // Ako je postavljeno, ovo je LIČNI uređaj tog zaposlenog — ne deli se sa
  // ostalim zaposlenima. Prijava na takvom uređaju zahteva samo PIN tog
  // zaposlenog (imenik zaposlenih se ne prikazuje). Null = deljeni terminal.
  employeeId   String?    @unique
  name         String
  deviceType   DeviceType @default(POS)
  registeredAt DateTime   @default(now())
  isActive     Boolean    @default(true)
  // Best-effort/throttled (~5 min) aktivnost, upisuje requireAuth (rbac.ts)
  // kad autentifikovan zahtev nosi ovaj deviceId. Isključivo informativno —
  // NIKAD se ne koristi za autorizaciju/aktivan-status uređaja (to je
  // isActive). Null = uređaj nikad nije video autentifikovan zahtev preko
  // requireAuth (npr. registrovan, ali još nije korišćen za prijavu).
  lastSeenAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  location   Location?  @relation(fields: [locationId], references: [id])
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([locationId])
  @@map("devices")
}

enum DeviceType {
  POS
  KDS
  BAR_DISPLAY
  ADMIN
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT LOG (append-only — bez update/delete kroz aplikativni sloj;
// u produkciji se dodatno sprovodi REVOKE UPDATE/DELETE na DB nivou za
// aplikativnog korisnika, van obima Prisma šeme)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  restaurantId  String
  // ── FAZA 5: nedostajalo od Faze 1 — bez ovoga Activity Log ne može da se
  // filtrira po lokaciji, što znači da bi menadžer sa pristupom SAMO jednoj
  // lokaciji video audit istoriju SVIH lokacija restorana (curenje preko
  // granice ovlašćenja). Nullable jer neke radnje (npr. auth.login pre nego
  // što se zna lokacija uređaja) nemaju prirodan locationId — takvi redovi
  // se jednostavno ne prikazuju kad je filter na konkretnu lokaciju.
  locationId    String?
  userId        String?
  role          String?
  entityType    String
  entityId      String
  action        String
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  deviceId      String?
  createdAt     DateTime @default(now())

  // ── FAZA 4: laka, deterministička klasifikacija (ne AI/ML) — omogućava
  // Fazi 5 da filtrira/agregira bez parsiranja previousValue/newValue JSON-a
  // za svaki red. Sva tri polja su opciona/imaju default — postojeći redovi
  // (Faza 1-3) ostaju validni bez migracije podataka; scoring se radi PRI
  // UPISU konkretnog događaja (jeftino, O(1)), NIKAD skupom upitom nad
  // istorijom u toku normalnog rada konobara (vidi audit-service.ts).
  category     String?
  severity     AuditSeverity @default(INFO)
  isSuspicious Boolean       @default(false)

  @@index([restaurantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([restaurantId, isSuspicious])
  @@index([restaurantId, category])
  @@index([restaurantId, locationId])
  @@map("audit_logs")
}

enum AuditSeverity {
  INFO
  WARNING
  HIGH
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 2 — MENU (kategorije + artikli)
//
// Menu model NAMERNO sadrži više polja nego što MVP UI izlaže (SKU, barcode,
// purchasePrice, image, trackStock, minimumStock) — ovo su "future-ready"
// kolone dogovorene u planu (docs/01-RCS-Plan-v2-MVP.md, tačka 9): ne
// implementiramo Inventory/Recipe/Supplier module sada, ali ne želimo da
// njihovo kasnije dodavanje zahteva migraciju postojećih MenuItem redova.
// Sve future-ready kolone su nullable/imaju bezopasan default — MVP admin
// UI ih ili ne prikazuje, ili ih prikazuje kao opciona polja bez posledice
// ako ostanu prazna.
// ─────────────────────────────────────────────────────────────────────────

model MenuCategory {
  id           String       @id @default(uuid())
  restaurantId String
  name         String
  slug         String
  type         CategoryType
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      MenuItem[]

  // Slug je stabilan identifikator za UPSERT u seed skripti — jedinstven
  // po restoranu, ne globalno (isti "grill" slug može postojati u dva
  // različita restorana kada MVP preraste u pravi multi-tenant UI).
  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("menu_categories")
}

enum CategoryType {
  FOOD
  DRINK
}

model MenuItem {
  id           String  @id @default(uuid())
  restaurantId String
  categoryId   String?
  // Nullable namerno: needsReview stavke (vidi ispod) mogu biti kreirane
  // pre nego što je kategorija/cena potvrđena — FK je i dalje čvrsta veza
  // (ON DELETE SET NULL, ne ostavlja "sirotu" referencu ka obrisanoj
  // kategoriji), samo dozvoljava privremeno "nekategorisano" stanje.

  name        String
  slug        String
  description String?

  price   Decimal @db.Decimal(12, 2)
  taxRate Decimal @default(20) @db.Decimal(5, 2)

  quantity Decimal? @db.Decimal(12, 3) // težina/zapremina broj (npr. 250)
  unit     String? // "g", "ml", "kom", "l" — slobodan tekst u MVP-u

  sku     String?
  barcode String?

  purchasePrice Decimal? @db.Decimal(12, 2) // future-ready: nabavna cena za maržu (nije MVP izveštaj)
  imageUrl      String?

  sortOrder   Int     @default(0)
  isActive    Boolean @default(true) // vidljivo u adminu / meniju uopšte
  isAvailable Boolean @default(true) // privremeno nema na stanju (Temporary Out Of Stock)

  // LEGACY / synced mirror — vidi inventoryTrackingMethod ispod, koje je od
  // P1.6 JEDINI autoritativni izvor za odluku o odbitku/dostupnosti. Ovo
  // polje se i dalje ažurira (trackStock = method === DIRECT_STOCK) radi
  // bezbednosti bilo kog preostalog starog koda koji bi ga čitao, ali se
  // više NIGDE u domain sloju ne koristi kao jedini uslov grananja.
  trackStock   Boolean  @default(false)
  minimumStock Decimal? @db.Decimal(12, 3)

  // P1.6: eksplicitna, restoranom-konfigurisana metoda praćenja zaliha po
  // artiklu — NIKAD izvedena iz MenuCategory (isti koncept artikla se sme
  // različito konfigurisati u različitim restoranima). Struktuurno
  // garantuje "tačno jedan put odbitka" (jedna kolona ne može istovremeno
  // biti DIRECT_STOCK i RECIPE) — zamenjuje dinamičku trackStock/
  // hasRecipe-postoji proveru koja je ranije branila dupli odbitak.
  // Backward-compat migracija (20260826180000): trackStock=true -> DIRECT_STOCK,
  // zatim artikli sa >=1 linijom recepture -> RECIPE (receptura pobeđuje,
  // isti prioritet kao stari getMenuItemIdsWithRecipes odbrana).
  inventoryTrackingMethod InventoryTrackingMethod @default(NO_TRACKING)

  preparationStation PreparationStation @default(NONE)

  needsReview Boolean @default(false) // cena/podaci čekaju potvrdu vlasnika/menadžera — vidi MenuItemReviewNote
  reviewNote  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete: meni artikli se arhiviraju/brišu često, istorijske porudžbine već čuvaju snapshot naziva/cene pa fizičko brisanje ovde ne ugrožava izveštaje

  // P1.5: fizička kategorija ZALIHE (KUHINJA/ŠANK -> podkategorija) — NAMERNO
  // ODVOJENO od `categoryId` (MenuCategory) iznad, koja organizuje MENI (šta
  // se prodaje), ne fizičku robu. Koristi je ISKLJUČIVO direct-stock artikal
  // (npr. Coca-Cola -> ŠANK -> Sokovi) radi organizacije Zalihe ekrana — nema
  // efekta na naplatu/odbitak (i dalje isključivo InventoryItem/trackStock).
  // Nullable: postojeći artikli ostaju "Nekategorisano" dok se ručno ne
  // dodele — nikad se ne pogađa dodela.
  inventoryCategoryId String?

  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id])
  category          MenuCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryCategory InventoryCategory?      @relation(fields: [inventoryCategoryId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]
  inventoryItems    InventoryItem[]
  modifierGroups    MenuItemModifierGroup[]
  recipeLines       MenuItemIngredient[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([inventoryCategoryId])
  @@index([restaurantId, isActive])
  @@index([categoryId])
  @@index([preparationStation])
  @@map("menu_items")
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA P3.2 — MODIFIKATORI / DODACI
//
// Modifikatori se tretiraju kao deo CENE I NAZIVA porudžbinske stavke, ne
// kao odvojeni "lažni" MenuItem-i (specifikacija #26/#28/#29 — promet
// dodataka mora pripasti roditeljskom artiklu/kategoriji/stanici bez ijedne
// izmene u reporting-service.ts/analytics-service.ts). Zato:
// OrderItem.price OD SADA znači "efektivna jedinična cena" (osnovna cena
// artikla + zbir izabranih priceDelta vrednosti), snapshot-ovana pri
// dodavanju u porudžbinu — isto kao što je do sada značila "osnovna cena".
// computeOrderTotals, void-service, Payment, Receipt.items i
// reporting-service.aggregateSoldItems zato NASTAVLJAJU DA RADE BEZ IZMENE
// (već množe price × quantity) — jedina promena je ŠTA se snapshot-uje u
// tom polju i par dodatnih redova (OrderItemModifier) za čitljiv prikaz.
// ─────────────────────────────────────────────────────────────────────────

model ModifierGroup {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  // required/min/max je JEDAN fleksibilan model umesto posebnih "tipova"
  // grupa (Veličina/Dodaci/...) — specifikacija #4/#5 eksplicitno traži da
  // se izbegnu hardkodovani tipovi grupa u korist ova tri broja/zastavice.
  required     Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  sortOrder    Int      @default(0)
  // Meka deaktivacija (specifikacija #36) — istorijski OrderItemModifier
  // snapshot redovi NIKAD ne zavise od ovog polja (imaju sopstveni snapshot
  // naziva/cene), pa deaktivacija grupe ne menja ništa u prošlim porudžbinama.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id])
  options    ModifierOption[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group              ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

// MenuItem <-> ModifierGroup je namerno many-to-many (specifikacija #34 —
// "Dodaci za pizzu" grupa se može vezati za više artikala) preko obične
// join tabele — ne dupliramo definiciju grupe po artiklu.
model MenuItemModifierGroup {
  id              String   @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// Istorijski snapshot IZABRANE opcije na porudžbinskoj stavci — ISTA
// filozofija kao OrderItem.name/price (zamrznuto u trenutku dodavanja,
// nikad se ne preračunava iz trenutnog ModifierOption reda). modifierOptionId
// je nullable + SetNull (isti obrazac kao MenuItem.categoryId) — brisanje
// izvorne opcije/grupe kasnije NE SME obrisati istorijski prikaz.
model OrderItemModifier {
  id               String   @id @default(uuid())
  orderItemId      String
  modifierOptionId String?
  groupName        String
  optionName       String
  priceDelta       Decimal  @db.Decimal(12, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([modifierOptionId])
  @@map("order_item_modifiers")
}

enum PreparationStation {
  KITCHEN
  BAR
  KITCHEN_AND_BAR
  NONE
}

// P1.6: vidi napomenu uz MenuItem.inventoryTrackingMethod iznad.
enum InventoryTrackingMethod {
  NO_TRACKING
  DIRECT_STOCK
  RECIPE
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 3 — STOLOVI, SMENE, PORUDŽBINE
// ─────────────────────────────────────────────────────────────────────────

model Floor {
  id           String   @id @default(uuid())
  restaurantId String
  locationId   String
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  location   Location          @relation(fields: [locationId], references: [id])
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@index([locationId])
  @@map("floors")
}

model RestaurantTable {
  id        String      @id @default(uuid())
  floorId   String
  label     String
  capacity  Int         @default(2)
  status    TableStatus @default(FREE)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  floor  Floor   @relation(fields: [floorId], references: [id])
  orders Order[]

  @@index([floorId])
  @@index([status])
  @@map("restaurant_tables")
}

enum TableStatus {
  FREE
  OCCUPIED
  AWAITING_BILL
  NEEDS_CLEANING
}

// ── SMENE ───────────────────────────────────────────────────────────────

model Shift {
  id           String      @id @default(uuid())
  restaurantId String
  locationId   String
  openedBy     String // employeeId
  openedAt     DateTime    @default(now())
  openingCash  Decimal     @default(0) @db.Decimal(12, 2)
  status       ShiftStatus @default(OPEN)
  closedBy     String?
  closedAt     DateTime?

  // ── FAZA 3: zatvaranje/rekonsilijacija — popunjava se ISKLJUČIVO u
  // closeShift transakciji, NIKAD posle (nema update endpoint-a). Ovo je
  // zamrznut snapshot u trenutku zatvaranja, ne uživo računata vrednost —
  // kasnija izmena povezanih Payment/Order redova (kojih posle zatvaranja
  // i ne sme biti, vidi closeShift) ne sme promeniti istorijski broj koji
  // je konobar/menadžer video i potvrdio pri zatvaranju.
  countedCash    Decimal? @db.Decimal(12, 2) // fizički prebrojana gotovina
  expectedCash   Decimal? @db.Decimal(12, 2) // openingCash + gotovinske uplate
  cashDifference Decimal? @db.Decimal(12, 2) // countedCash - expectedCash; NIKAD tiho "ispravljeno"
  cardTotal      Decimal? @db.Decimal(12, 2)
  totalRevenue   Decimal? @db.Decimal(12, 2) // cashTotal + cardTotal
  orderCount     Int? // broj naplaćenih porudžbina u smeni

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  location   Location        @relation(fields: [locationId], references: [id])
  orders     Order[]
  payments   Payment[]
  itemVoids  OrderItemVoid[]

  // Samo jedna otvorena smena po lokaciji u datom trenutku — sprečava da
  // dva konobara slučajno otvore paralelne smene na istoj kasi. Delimični
  // unique indeks (WHERE status = 'OPEN') se dodaje u DDL-u ispod jer
  // Prisma ne podržava partial unique index nativno u schema sintaksi za
  // sve provajdere podjednako pouzdano — primenjeno ručno, vidi napomenu.
  @@index([restaurantId])
  @@index([locationId])
  @@index([status])
  // ── FAZA 6: kompozitni indeks za 5-godišnje date-range izveštaje —
  // dosadašnji indeksi su svi single-column, Postgres bi morao da preseca
  // 2-3 odvojena index scan-a umesto jednog range scan-a po restoranu +
  // lokaciji + datumu. Čisto aditivno, ne menja postojeće upite.
  @@index([restaurantId, locationId, openedAt])
  @@index([restaurantId, locationId, closedAt])
  @@map("shifts")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ── PORUDŽBINE ──────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(uuid())
  restaurantId   String
  locationId     String
  tableId        String
  shiftId        String
  openedBy       String // employeeId (konobar)
  guestCount     Int?
  status         OrderStatus @default(DRAFT)
  idempotencyKey String? // postavlja se TEK pri submitOrder — sprečava dupli submit istog draft-a
  submittedAt    DateTime?
  // ── FAZA 6: popust na nivou porudžbine — MVP, additive, nullable. Nema
  // posebnog Discount modela (vidi docs/01-RCS-Plan-v2-MVP.md, tačka 9:
  // "popust je polje na Order/OrderItem, ne poseban model" dok ne preraste
  // u kupone/pravila). Default null = postojeće porudžbine nepromenjene.
  discountAmount Decimal?    @db.Decimal(12, 2)
  discountReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id])
  location         Location            @relation(fields: [locationId], references: [id])
  table            RestaurantTable     @relation(fields: [tableId], references: [id])
  shift            Shift               @relation(fields: [shiftId], references: [id])
  items            OrderItem[]
  events           OrderEvent[]
  // FAZA 8 (Split Bill): jedan Order sada može imati VIŠE Payment/Receipt
  // redova (jedan po delimičnoj naplati) — vidi napomenu uz Payment/Receipt
  // modele ispod. `payment`/`receipt` (jednina) su UKLONJENI zajedno sa
  // @unique na Payment.orderId/Receipt.orderId; svaki pozivalac koji je
  // ranije čitao `order.payment`/`order.receipt` sada čita `order.payments`/
  // `order.receipts` (niz, prazan dok porudžbina nije naplaćena ni delom).
  payments         Payment[]
  receipts         Receipt[]
  itemVoids        OrderItemVoid[]
  printJobs        PrintJob[]
  itemTransfersOut OrderItemTransfer[] @relation("TransferSourceOrder")
  itemTransfersIn  OrderItemTransfer[] @relation("TransferDestinationOrder")

  // Idempotency key je jedinstven PO RESTORANU kad je postavljen — dupli
  // submit sa istim ključem (npr. duplo-kliknuto dugme, retry mreže) pada
  // na unique constraint umesto da kreira drugu porudžbinu.
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId])
  @@index([locationId])
  @@index([tableId])
  @@index([shiftId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  // menuItemId NIJE obavezan FK-referenca za prikaz — snapshot polja ispod
  // (name/price/taxRate) su izvor istine za ovu porudžbinu zauvek, čak i
  // ako se MenuItem kasnije izmeni ili obriše. menuItemId se čuva SAMO kao
  // slaba referenca za izveštaje ("koliko puta je artikal X prodat"), zato
  // je onDelete: SetNull — brisanje MenuItem-a ne sme oboriti OrderItem.
  menuItemId String?

  name               String // snapshot naziva u trenutku slanja
  price              Decimal            @db.Decimal(12, 2) // snapshot cene
  taxRate            Decimal            @db.Decimal(5, 2) // snapshot poreske stope
  quantity           Int                @default(1)
  note               String? // jedna slobodna napomena po stavci (MVP)
  preparationStation PreparationStation @default(NONE) // snapshot stanice u trenutku slanja

  // DRAFT pre-submit; afterwards this is a waiter-facing aggregate of
  // stationStates (least-advanced station). KDS never mutates it directly.
  status    OrderItemStatus @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // VIŠE-KRUŽNO NARUČIVANJE: KADA je OVA konkretna stavka poslata kuhinji/
  // šanku (DRAFT -> SUBMITTED prelaz) — null dok je još DRAFT. Jedna
  // porudžbina (Order) sada može primiti VIŠE krugova slanja tokom svog
  // životnog veka (order-service.ts submitOrder), pa Order.submittedAt
  // (vreme PRVOG slanja) više nije dovoljno da se razlikuje "stari" od
  // "novopristiglog" kruga — ovo polje je TAČNO ta minimalna razlika,
  // namerno bez posebnog "batch/round" modela (nepotrebna složenost —
  // poređenje po vremenu je dovoljno i za KDS i za audit/izveštaje).
  submittedAt DateTime?

  // FAZA 8 (Split Bill): koliko od `quantity` je VEĆ naplaćeno kroz neki
  // PaymentItem red (vidi Payment/PaymentItem napomenu ispod). Invarijanta
  // održavana na SVAKOM mestu koje menja `quantity` ili `paidQuantity`
  // (splitBill, voidOrderItem, item-transfer): 0 <= paidQuantity <= quantity
  // uvek. Void i transfer smeju dirati SAMO neplaćeni ostatak
  // (quantity - paidQuantity) — nikad već naplaćenu količinu.
  paidQuantity Int @default(0)

  order         Order               @relation(fields: [orderId], references: [id])
  menuItem      MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  stationStates OrderItemStation[]
  voids         OrderItemVoid[]
  modifiers     OrderItemModifier[]
  paymentItems  PaymentItem[]
  transfersOut  OrderItemTransfer[] @relation("TransferSourceItem")
  transfersIn   OrderItemTransfer[] @relation("TransferDestinationItem")

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
  @@index([preparationStation])
  @@map("order_items")
}

// Per-station production state. OrderItem remains the single commercial item;
// this model only allows kitchen and bar to progress independently.
model OrderItemStation {
  id          String            @id @default(uuid())
  orderItemId String
  station     ProductionStation
  status      OrderItemStatus   @default(SUBMITTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, station])
  @@index([station, status])
  @@map("order_item_stations")
}

enum ProductionStation {
  KITCHEN
  BAR
}

enum OrderItemStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

// Append-only log svake promene porudžbine — konobar ne menja poslatu
// stavku direktno (vidi pravilo iz v1 plana), svaka izmena je nov event.
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  type      String // "item_added", "submitted", "item_cancel_requested", ...
  payload   Json?
  createdBy String // employeeId
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@map("order_events")
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 2 — NAPLATA (Payment + Receipt)
//
// Payment.orderId je @unique — namerno "tačno jedno plaćanje po porudžbini"
// u MVP-u (vidi docs/01-RCS-Plan-v2-MVP.md, tačka 10: ova odluka je u
// modelu, ne samo u UI-ju, PA JE zato jedina prava zaštita od duplog
// plaćanja na DB nivou — servisni sloj radi dodatnu atomsku proveru statusa
// porudžbine PRE upisa, ali unique constraint je krajnja linija odbrane
// protiv race condition-a). Split plaćanje kasnije zahteva uklanjanje ovog
// unique-a i uvođenje PaymentAllocation — nije MVP.
//
// Receipt je NEZAVISAN, POTPUNO zamrznut snapshot u trenutku plaćanja —
// items/subtotal/tax/total/nazivi se NIKAD ne preračunavaju iz Order/
// OrderItem/MenuItem posle kreiranja. Kasnija izmena cene artikla ili
// naziva restorana ne sme promeniti istorijski račun.
//
// FAZA 8 — SPLIT BILL: `Payment.orderId @unique` je UKLONJEN (bio je
// najavljen kao MVP-only ograničenje tačno ovde od Faze 2) — jedan Order
// sada može imati VIŠE Payment redova, jedan po delimičnoj naplati.
// PaymentItem (ispod) je novi model koji beleži TAČNO koje OrderItem
// količine je pokrila koja Payment — bez njega ne bi bilo moguće znati šta
// je već naplaćeno po stavci niti bezbedno sprečiti duplu naplatu/duplu
// dedukciju zaliha iste količine. Receipt.orderId @unique je iz istog
// razloga uklonjen (jedan Receipt po Payment-u ostaje, @unique na
// paymentId ostaje netaknut) — svaka delimična naplata dobija svoj
// zaseban, i dalje potpuno zamrznut, račun koji prikazuje SAMO tu uplatu.
// ─────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  restaurantId   String
  locationId     String
  // Smena AKTIVNA U TRENUTKU PLAĆANJA (ne nužno order.shiftId) — gotovina
  // je fizički primljena u smeni koja je tada otvorena, bitno za tačno
  // zatvaranje smene/rekonsilijaciju u Fazi 3.
  shiftId        String
  method         PaymentMethod
  // Autoritativan iznos — UVEK izračunat na serveru iz OrderItem redova u
  // trenutku plaćanja, NIKAD preuzet iz klijentskog zahteva.
  amount         Decimal       @db.Decimal(12, 2)
  tenderedAmount Decimal       @db.Decimal(12, 2) // gotovina: šta je konobar primio; kartica: = amount
  changeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  completedBy    String // employeeId
  completedAt    DateTime      @default(now())

  // FAZA 8: klijent generiše UUID PRE prvog pokušaja split-plaćanja i šalje
  // isti ključ na svaki retry — isti idempotency obrazac kao
  // Order.idempotencyKey/submitOrder. Nullable jer stariji (pre-Faza 8)
  // Payment redovi i dalje-jedno-plaćanje pozivi nemaju/ne moraju imati
  // ključ; `@@unique([orderId, idempotencyKey])` zamenjuje staro
  // `orderId @unique` kao odbrana od duple naplate NA DB NIVOU (Postgres
  // dozvoljava više NULL vrednosti u unique indeksu, pa se ne-idempotentni
  // pozivi međusobno ne blokiraju ovim).
  idempotencyKey String?
  // FAZA 8: prorata udela Order.discountAmount koji OVA konkretna uplata
  // nosi — vidi split-bill-service.ts za tačnu formulu (poslednja uplata
  // koja zatvara porudžbinu uvek preuzima tačan ostatak, bez zaokruživanja
  // koje bi "procurilo"). Null za porudžbine bez popusta ILI za plaćanja
  // pre Faze 8 (nema retroaktivnog popunjavanja).
  discountAmount Decimal? @db.Decimal(12, 2)
  // FAZA 8: true kad je ovo JEDNA od VIŠE uplata za istu porudžbinu (bilo
  // koja strana Split Bill toka) — čisto informativno polje za UI/izveštaj
  // (npr. "Plaćanje 1/2"), nikad korišćeno za autorizaciju/računicu.
  isSplit        Boolean  @default(false)

  order   Order         @relation(fields: [orderId], references: [id])
  shift   Shift         @relation(fields: [shiftId], references: [id])
  receipt Receipt?
  items   PaymentItem[]

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@index([restaurantId])
  @@index([locationId])
  @@index([shiftId])
  @@index([completedAt])
  // ── FAZA 6: Payment.completedAt je izvor istine za SVA finansijska
  // grupisanja po danu (vidi reporting-service.ts) — ovaj kompozitni
  // indeks je najvažniji za 5-godišnji istorijski upit performance.
  @@index([restaurantId, locationId, completedAt])
  @@map("payments")
}

// FAZA 8 — SPLIT BILL: alokacija — TAČNO koju količinu jedne OrderItem
// stavke je pokrila jedna Payment. Zbir PaymentItem.quantity preko SVIH
// Payment redova za dati orderItemId MORA uvek biti jednak
// OrderItem.paidQuantity (održavano atomski u istoj transakciji u
// split-bill-service.ts) — ovo je izvor istine za "šta je već plaćeno po
// stavci", OrderItem.paidQuantity je samo denormalizovan zbir radi brzih
// provera bez agregacije pri svakom čitanju. unitPrice/taxRate su
// SNAPSHOT sa OrderItem-a u trenutku TE naplate (ista filozofija kao
// Receipt/OrderItemVoid) — kasnija izmena cene artikla ne menja prošle
// alokacije.
model PaymentItem {
  id          String   @id @default(uuid())
  paymentId   String
  orderItemId String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  payment   Payment   @relation(fields: [paymentId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([paymentId, orderItemId])
  @@index([paymentId])
  @@index([orderItemId])
  @@map("payment_items")
}

model Receipt {
  id             String   @id @default(uuid())
  // Globalno monoton brojač (Postgres sekvenca ispod autoincrement-a) —
  // atomski dodeljen bez posebne brojačke tabele/race-a; prikazuje se kao
  // broj računa u UI/štampi (Faza 6).
  sequenceNumber Int      @default(autoincrement())
  orderId        String
  paymentId      String   @unique
  restaurantId   String
  locationId     String
  issuedAt       DateTime @default(now())

  // Snapshot polja ispod se NIKAD ne ažuriraju posle kreiranja — vidi
  // napomenu na vrhu sekcije.
  restaurantName      String
  restaurantLegalName String?
  tableLabel          String
  waiterName          String
  paymentMethod       PaymentMethod
  subtotal            Decimal       @db.Decimal(12, 2)
  taxTotal            Decimal       @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  currency            String
  // [{ name, price, taxRate, quantity, lineTotal }]
  items               Json
  // [{ taxRate, taxableAmount, taxAmount }] — grupisano po poreskoj stopi,
  // za prikaz PDV rekapitulacije na računu (Faza 6).
  taxBreakdown        Json
  // ── FAZA 6: zamrznut snapshot popusta primenjenog na Order u trenutku
  // plaćanja (vidi Order.discountAmount) — nullable, postojeći računi
  // ostaju nepromenjeni.
  discountAmount      Decimal?      @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([restaurantId])
  @@index([locationId])
  @@index([issuedAt])
  @@map("receipts")
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 4 — ANTI-FRAUD / ODGOVORNOST OSOBLJA (VOID/KOREKCIJA POSLATE STAVKE)
//
// Ključno pravilo specifikacije: pošto je stavka POSLATA kuhinji/šanku, ona
// je deo operativne istorije restorana i NIKAD se tiho ne briše/umanjuje.
// OrderItem.quantity se i dalje umanjuje (da bi se naplata/KDS prikaz
// automatski ažurirali kroz POSTOJEĆU logiku bez ikakvih izmena tamo), ali
// SVAKA takva izmena mora ostaviti trag ovde — koliko je bilo PRE, koliko
// je poništeno, koliko ostaje POSLE, razlog, obrazloženje, ko i kada.
//
// Namerno POSEBAN model (ne samo AuditLog red) — Faza 5 (vlasnički izveštaj)
// treba efikasno da agregira po zaposlenom/razlogu/vrednosti bez parsiranja
// JSON-a iz previousValue/newValue na svaki upit. AuditLog i dalje dobija
// svoj (generički) zapis iz iste transakcije — OVO NIJE drugi, paralelni
// audit sistem, samo strukturirano proširenje analogno Payment/Receipt
// paru iz Faze 2.
// ─────────────────────────────────────────────────────────────────────────

enum VoidReasonCode {
  ORDERED_BY_MISTAKE
  WRONG_QUANTITY
  CUSTOMER_CHANGED_MIND
  WRONG_ITEM
  KITCHEN_UNAVAILABLE
  KITCHEN_ISSUE
  QUALITY_ISSUE
  MANAGER_DECISION
  OTHER
}

model OrderItemVoid {
  id           String @id @default(uuid())
  restaurantId String
  locationId   String
  orderId      String
  orderItemId  String
  shiftId      String
  // Snapshot (String, ne FK) — isti razlog kao Receipt.tableLabel: sto se
  // može kasnije preimenovati, istorijski zapis mora ostati čitljiv kakav
  // je bio u trenutku radnje.
  tableLabel   String

  // Snapshot naziva/cene sa OrderItem-a u trenutku poništavanja — NIKAD
  // trenutna MenuItem cena (zahtev specifikacije #8).
  itemName  String
  unitPrice Decimal @db.Decimal(12, 2)

  quantityBefore Int
  voidedQuantity Int
  quantityAfter  Int
  voidedValue    Decimal @db.Decimal(12, 2) // unitPrice * voidedQuantity

  reasonCode  VoidReasonCode
  explanation String // slobodan tekst, obavezan, validiran na servisu (vidi void-service.ts)

  voidedBy     String // employeeId (bez FK — ista konvencija kao Order.openedBy/Payment.completedBy)
  voidedByRole String // snapshot uloge u trenutku radnje (uloge se mogu kasnije menjati)
  voidedAt     DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  shift     Shift     @relation(fields: [shiftId], references: [id])

  @@index([restaurantId])
  @@index([locationId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([shiftId])
  @@index([voidedBy])
  @@index([voidedAt])
  // ── FAZA 6: kompozitni indeks za istorijski void izveštaj po periodu.
  @@index([restaurantId, locationId, voidedAt])
  @@map("order_item_voids")
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 8 — TRANSFER STAVKI IZMEĐU STOLOVA
//
// Audit trag za svaki transfer (potpun ili delimičan) neplaćene količine
// jedne OrderItem stavke sa jedne (izvorne) na drugu (odredišnu) porudžbinu.
// Transfer NIJE prodaja niti storno — nikad ne kreira Payment/Receipt/
// InventoryMovement/IngredientMovement red (transfer-service.ts). Poseban
// model (ne samo OrderEvent) iz istog razloga kao OrderItemVoid: efikasna
// agregacija/pretraga po izvoru/odredištu/stavci bez parsiranja JSON
// payload-a, sa sopstvenim FK-ovima ka obe porudžbine i obe (izvorna i
// odredišna, moguće nova) OrderItem stavke.
// ─────────────────────────────────────────────────────────────────────────

model OrderItemTransfer {
  id           String @id @default(uuid())
  restaurantId String
  locationId   String

  sourceOrderId          String
  sourceOrderItemId      String
  destinationOrderId     String
  destinationOrderItemId String

  // Snapshot (String, ne FK) — ista konvencija kao OrderItemVoid.tableLabel:
  // sto se može kasnije preimenovati, istorijski zapis ostaje čitljiv kakav
  // je bio u trenutku transfera.
  sourceTableLabel      String
  destinationTableLabel String
  itemName              String
  quantity              Int

  transferredBy     String // employeeId — ista konvencija kao Order.openedBy (bez FK)
  transferredByRole String // snapshot uloge u trenutku radnje
  transferredAt     DateTime @default(now())

  sourceOrder          Order     @relation("TransferSourceOrder", fields: [sourceOrderId], references: [id])
  destinationOrder     Order     @relation("TransferDestinationOrder", fields: [destinationOrderId], references: [id])
  sourceOrderItem      OrderItem @relation("TransferSourceItem", fields: [sourceOrderItemId], references: [id])
  destinationOrderItem OrderItem @relation("TransferDestinationItem", fields: [destinationOrderItemId], references: [id])

  @@index([restaurantId])
  @@index([locationId])
  @@index([sourceOrderId])
  @@index([destinationOrderId])
  @@index([sourceOrderItemId])
  @@index([destinationOrderItemId])
  @@index([transferredAt])
  @@map("order_item_transfers")
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 6 — ŠTAMPA (kuhinjski/šank tiket, račun) I PODEŠAVANJA RESTORANA
//
// PrintJob je dispatch-tracking model, NE novi izvor istine za rutiranje
// porudžbina — OrderItemStation ostaje jedini autoritativan mehanizam za
// to (vidi production-service.ts). PrintJob samo beleži da je za već
// postojeće stanje (poslata stavka na stanicu, storniranje, plaćanje)
// pokušana/uspela štampa, i sprečava duple fizičke otiske.
//
// Idempotentnost: @@unique([orderId, dispatchKey]) — dispatchKey je
// deterministički po vrsti događaja ("submit:KITCHEN", "void:{voidId}:BAR",
// "receipt:{paymentId}", "receipt-reprint:{paymentId}:{clientKey}").
// Ponovljen poziv (refresh, retry, React re-render) sa istim dispatchKey-jem
// pogađa isti red (upsert) — nikad ne kreira drugi PrintJob za isti
// događaj. Reprint svesno koristi NOVI dispatchKey (klijent generiše nov
// ključ po kliku) — svaki reprint je zaseban, auditovan red, ne blokiran
// unique constraint-om prethodnog ispisa.
// ─────────────────────────────────────────────────────────────────────────

enum PrintJobType {
  KITCHEN
  BAR
  RECEIPT
}

enum PrintJobStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED
}

model PrintJob {
  id            String             @id @default(uuid())
  restaurantId  String
  locationId    String
  orderId       String
  type          PrintJobType
  // KITCHEN | BAR za tiket-tipove; null za RECEIPT (račun nije vezan za
  // pojedinačnu stanicu).
  station       ProductionStation?
  dispatchKey   String
  status        PrintJobStatus     @default(PENDING)
  attemptCount  Int                @default(0)
  // Renderovani sadržaj tiketa/računa u trenutku dispatch-a — zamrznut
  // snapshot, ista konvencija kao Receipt: reprint NIKAD ne preračunava
  // iz Order/OrderItem, samo ponovo ispisuje ovaj JSON.
  content       Json
  isReprint     Boolean            @default(false)
  reprintOfId   String?
  requestedBy   String // employeeId, bez FK — ista konvencija kao Order.openedBy
  failureReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  printedAt     DateTime?

  order     Order      @relation(fields: [orderId], references: [id])
  reprintOf PrintJob?  @relation("PrintJobReprints", fields: [reprintOfId], references: [id])
  reprints  PrintJob[] @relation("PrintJobReprints")

  @@unique([orderId, dispatchKey])
  @@index([restaurantId])
  @@index([locationId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("print_jobs")
}

enum PrinterType {
  BROWSER
  ESC_POS_LAN
  NETWORK
}

model RestaurantSettings {
  restaurantId      String   @id
  address           String?
  phone             String?
  taxIdNumber       String?
  receiptFooterText String?
  // Default primenjen na aplikativnom sloju kad je null: "Radni nalog –
  // nije fiskalni račun" (vidi requirement #4 — ovo NIJE fiskalni račun
  // dok ne postoji stvarna fiskalizaciona integracija).
  receiptLegalNote  String?
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("restaurant_settings")
}

model PrinterConfig {
  id           String       @id @default(uuid())
  restaurantId String
  locationId   String
  station      PrintJobType // KITCHEN | BAR | RECEIPT
  name         String
  printerType  PrinterType  @default(BROWSER)
  paperWidthMm Int          @default(80) // 58mm podržan bez migracije — samo druga vrednost
  isEnabled    Boolean      @default(true)
  autoPrint    Boolean      @default(false)
  copies       Int          @default(1)
  ipAddress    String? // rezervisano za budući ESC_POS_LAN/NETWORK adapter
  port         Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([locationId, station])
  @@index([restaurantId])
  @@index([locationId])
  @@map("printer_configs")
}

// ─────────────────────────────────────────────────────────────────────────
// FAZA 7 — INVENTORY (zalihe)
//
// InventoryItem: jedan red po (location, menuItem) paru. Čuva tekuće stanje.
// InventoryMovement: nepromenjiv ledger svake izmene zalihe.
//
// Idempotentnost SALE kretanja: @@unique([paymentId, menuItemId]) sprečava
// dupli odbitak pri ponovljenom pozivu — PostgreSQL dozvoljava više NULL
// vrednosti u unique indeksu, pa non-SALE kretanja (ADJUSTMENT itd.) koja
// imaju paymentId=NULL mogu koegzistirati bez konflikta.
//
// Konkurentnost: Prisma updateMany sa uvjetom currentStock >= delta daje
// atomski SQL UPDATE bez ručnog SELECT-FOR-UPDATE.
// ─────────────────────────────────────────────────────────────────────────

enum MovementType {
  INITIAL
  OPENING_STOCK
  RECEIPT
  SALE
  ADJUSTMENT
  WRITE_OFF
  // Inventura (fizičko prebrojavanje) — vidi InventoryCountLine ispod.
  INVENTORY_CORRECTION
}

model InventoryItem {
  id           String   @id @default(uuid())
  restaurantId String
  locationId   String
  menuItemId   String
  currentStock Decimal  @default(0) @db.Decimal(12, 3)
  unit         String   @default("kom")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id])
  location   Location            @relation(fields: [locationId], references: [id])
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id])
  movements  InventoryMovement[]

  @@unique([locationId, menuItemId])
  @@index([restaurantId])
  @@index([menuItemId])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String       @id @default(uuid())
  restaurantId    String
  locationId      String
  menuItemId      String
  inventoryItemId String
  type            MovementType
  quantityDelta   Decimal      @db.Decimal(12, 3)
  quantityBefore  Decimal      @db.Decimal(12, 3)
  quantityAfter   Decimal      @db.Decimal(12, 3)
  paymentId       String?
  orderId         String?
  employeeId      String?
  reason          String?
  // Inventura: generička poveznica ka izvoru korekcije — vidi identičan,
  // već postojeći par kolona na IngredientMovement za isti razlog
  // (paymentId/orderId ostaju posebne, dedikovane kolone za SALE; ovaj par
  // je za korekcije koje ne dolaze iz naplate). referenceType="INVENTORY_COUNT",
  // referenceId=InventoryCountSession.id za sve INVENTORY_CORRECTION redove.
  referenceType   String?
  referenceId     String?
  createdAt       DateTime     @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([paymentId, menuItemId])
  @@index([inventoryItemId])
  @@index([restaurantId])
  @@index([locationId])
  @@index([menuItemId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ─────────────────────────────────────────────────────────────────────────
// P1 — NORMATIVI / RECEPTURE + SIROVINSKI LAGER (foundation)
//
// Namerno POTPUNO ODVOJENO od InventoryItem/InventoryMovement iznad, koji
// prate gotov MenuItem "na stanju" (npr. "koliko flaša Koka-Kole imamo") —
// jedna prodata jedinica = jedan dekrement. Ingredient/IngredientStock prati
// SIROVINE (meso, luk, ulje...) čiju potrošnju po prodatom artiklu određuje
// receptura (MenuItemIngredient), ne 1:1 odnos. Ova faza NAMERNO ne povezuje
// recepture sa prodajom (nema automatskog raščlanjivanja pri naplati) — to
// je sledeća, posebno odobrena faza. Do tada: recepture i sirovinski lager
// postoje, ali se ne diraju automatski.
//
// Permisije: namerno se PONOVO KORISTE postojeći 'inventory.view'/
// 'inventory.manage' (već OWNER/ADMIN/MANAGER, vidi migraciju
// 20260819140000_inventory) — ista operativna granica važi i za sirovine/
// recepture, nema potrebe za novim permission kodovima.

enum UnitOfMeasure {
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  PIECE
}

// P1.5: SIROVINSKA (fizička) kategorija — NAMERNO odvojena hijerarhija od
// MenuCategory iznad. MenuCategory organizuje šta se PRODAJE (meni);
// InventoryCategory organizuje fizičku ROBU koju restoran drži na stanju
// (KUHINJA/ŠANK -> podkategorija), bez obzira da li ta roba ulazi u
// recepturu (Ingredient) ili se prodaje direktno (MenuItem/InventoryItem —
// vidi inventoryCategoryId na MenuItem-u iznad). Restoran-scoped,
// samo-referencirajuća (parent/children) — TAČNO DVA nivoa u praksi
// (KUHINJA/ŠANK pa podkategorija), ali model namerno ne ograničava dubinu na
// schema nivou (jednostavnije nego posebno "level" polje, isti šablon kao
// MenuCategory da nema veštačkog ograničenja).
//
// Deaktivacija umesto brisanja (isti obrazac kao Ingredient/MenuItem) — brisanje
// kategorije koja ima dodeljene Ingredient/MenuItem redove bi ih osirotilo ili
// zahtevalo kaskadno reosiromašenje; deactivate je bezbedno i vraćivo.
model InventoryCategory {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  parentId     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id])
  parent      InventoryCategory?  @relation("InventoryCategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    InventoryCategory[] @relation("InventoryCategoryChildren")
  ingredients Ingredient[]
  menuItems   MenuItem[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@index([parentId])
  @@map("inventory_categories")
}

model Ingredient {
  id                  String        @id @default(uuid())
  restaurantId        String
  name                String
  unit                UnitOfMeasure
  category            String? // slobodan tekst u MVP-u (npr. "Meso", "Povrće") — isti obrazac kao MenuItem.unit
  // P1.5: strukturirana zamena za `category` (free-text) iznad — `category`
  // NAMERNO ostaje netaknuto polje (postojeći podaci, ako ih ima, se ne
  // dodiruju), ali nova Admin UI koristi ISKLJUČIVO inventoryCategoryId.
  // Nullable: postojeće/nove sirovine bez dodele ostaju "Nekategorisano".
  inventoryCategoryId String?
  sku                 String?
  isActive            Boolean       @default(true) // deaktivacija umesto brisanja — vidi napomenu ispod
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id])
  inventoryCategory InventoryCategory?   @relation(fields: [inventoryCategoryId], references: [id], onDelete: SetNull)
  stocks            IngredientStock[]
  movements         IngredientMovement[]
  recipeLines       MenuItemIngredient[]

  // NAMERNO nema @@unique na imenu — isti obrazac kao MenuItem (slug nosi
  // jedinstvenost tamo; ovde jedinstvenost imena nije poslovni zahtev, dve
  // sirovine mogu slučajno imati sličan naziv u različitim kategorijama).
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@index([inventoryCategoryId])
  @@map("ingredients")
}

model IngredientStock {
  id                String   @id @default(uuid())
  restaurantId      String
  locationId        String
  ingredientId      String
  currentStock      Decimal  @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal? @db.Decimal(12, 3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id])
  location   Location             @relation(fields: [locationId], references: [id])
  ingredient Ingredient           @relation(fields: [ingredientId], references: [id])
  movements  IngredientMovement[]

  @@unique([locationId, ingredientId])
  @@index([restaurantId])
  @@index([ingredientId])
  @@map("ingredient_stocks")
}

enum IngredientMovementType {
  OPENING_STOCK
  RECEIPT
  ADJUSTMENT
  WRITE_OFF
  // Rezervisano za buduće faze (nema koda koji ih još piše — vidi napomenu
  // na vrhu ove sekcije): SALE nastaje kad recepture budu povezane sa
  // naplatom; INVENTORY_CORRECTION uz buduće fizičko popisivanje;
  // RETURN_TO_SUPPLIER uz buduće upravljanje dobavljačima.
  SALE
  INVENTORY_CORRECTION
  RETURN_TO_SUPPLIER
}

model IngredientMovement {
  id                String                 @id @default(uuid())
  restaurantId      String
  locationId        String
  ingredientId      String
  ingredientStockId String
  type              IngredientMovementType
  quantityDelta     Decimal                @db.Decimal(12, 3)
  quantityBefore    Decimal                @db.Decimal(12, 3)
  quantityAfter     Decimal                @db.Decimal(12, 3)
  // P1.2: dodato kad je SALE tip implementiran (automatsko skidanje po
  // normativu pri naplati) — isti obrazac kao InventoryMovement.paymentId/
  // orderId (plain nullable kolone, bez FK-a, @@unique kao idempotency
  // brava). Zamenjuje ranije planirani generički referenceType/referenceId
  // par za OVAJ slučaj upotrebe; referenceType/referenceId ostaju za buduće
  // tipove (INVENTORY_CORRECTION/RETURN_TO_SUPPLIER) kojima dedikovane
  // kolone ne odgovaraju.
  paymentId         String?
  orderId           String?
  employeeId        String?
  reason            String?
  referenceType     String?
  referenceId       String?
  createdAt         DateTime               @default(now())

  ingredient      Ingredient      @relation(fields: [ingredientId], references: [id])
  ingredientStock IngredientStock @relation(fields: [ingredientStockId], references: [id])

  @@unique([paymentId, ingredientId])
  @@index([ingredientStockId])
  @@index([restaurantId])
  @@index([locationId])
  @@index([ingredientId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("ingredient_movements")
}

// Receptura (Normativ) — koliko koje sirovine ide u JEDAN prodat MenuItem.
// Količina je izražena u jedinici SIROVINE (Ingredient.unit) — namerno bez
// posebnog "unit override" polja po liniji recepture, da ne bi trebalo
// konverzije jedinica u ovoj fazi (vidi packages/domain/inventory/
// unit-of-measure.ts za konverzionu tabelu pripremljenu za kasniju fazu).
model MenuItemIngredient {
  id           String   @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Decimal  @db.Decimal(12, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
  @@map("menu_item_ingredients")
}

// ─────────────────────────────────────────────────────────────────────────
// OPERATIVNA DOSTUPNOST (Kuhinja/Šank "NIJE DOSTUPNO")
//
// POTPUNO NEZAVISNO od zalihe (InventoryItem/IngredientStock) — nula/
// negativna zaliha je i dalje SAMO upozorenje, prodaja ostaje dozvoljena
// (vidi getInventoryStockStatus). Ovaj model je JEDINI izvor tvrde blokade
// za NOVO naručivanje: kuhinja/šank ručno označe artikal privremeno
// nedostupnim (pokvarena oprema, nema struje/gasa, fizički nema sastojka
// iako je zaliha "na papiru" još pozitivna, itd.) — razlog koji zaliha sama
// po sebi ne može da izrazi.
//
// NIKAD se ne oslanja na staro MenuItem.isAvailable (restoran-globalno,
// bez lokacije, iz Admin meni ekrana) — ovo je NOVA, po-lokaciji granica,
// namerno odvojena (isti artikal može biti dostupan na jednoj lokaciji a
// nedostupan na drugoj, npr. pokvaren friteza samo u jednoj poslovnici).
//
// ODSUSTVO REDA = DOSTUPAN (namerno najbezbednija podrazumevana vrednost —
// nova lokacija/artikal kombinacija nikad nije slučajno blokirana). Red se
// kreira SAMO kad neko eksplicitno označi nedostupnim; ponovno omogućavanje
// BRIŠE red (vraća se na podrazumevano "odsustvo = dostupan"), ne ostavlja
// zastareo isAvailable=true red — vidi availability-service.ts.
// ─────────────────────────────────────────────────────────────────────────

enum AvailabilityReasonCode {
  NEMA_PROIZVODA
  NEMA_SIROVINE_FIZICKI
  OPREMA_KVAR
  NEMA_STRUJE_GASA
  STANICA_NE_RADI
  NIJE_MOGUCE_PRIPREMITI
  DRUGO
}

model MenuItemAvailability {
  id           String @id @default(uuid())
  // Plain (bez @relation) — ista konvencija kao OrderItemTransfer.restaurantId/
  // locationId iznad: čist scoping/target podatak, ne navigiran kroz Prisma
  // include, pa ne zahteva izmenu MenuItem/Restaurant/Location modela.
  restaurantId String
  locationId   String
  menuItemId   String

  isAvailable Boolean                 @default(false) // red postoji SAMO kad je false — vidi napomenu iznad
  reasonCode  AvailabilityReasonCode?
  note        String?
  updatedBy   String // employeeId, bez FK — ista konvencija kao Order.openedBy
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([locationId, menuItemId])
  @@index([restaurantId])
  @@index([menuItemId])
  @@map("menu_item_availabilities")
}

// ─────────────────────────────────────────────────────────────────────────
// INVENTURA (fizičko prebrojavanje zaliha)
//
// Pokriva ISKLJUČIVO Ingredient (sirovine) i DIRECT_STOCK MenuItem (gotovi
// proizvodi na direktnoj zalihi) — RECIPE stavke (nema sopstvene zalihe,
// samo recepturu) i NO_TRACKING stavke (zaliha se uopšte ne prati) se
// NIKAD ne broje, odbijeno na servisu (inventura-service.ts).
//
// KONKURENTNOST: InventoryCountLine.systemQtySnapshot je stanje zabeleženo
// U TRENUTKU dodavanja reda u sesiju. Pri potvrdi (confirmSession), tačna
// trenutna (živa) zaliha se PONOVO čita I atomski upoređuje sa snapshot-om
// KROZ JEDAN uslovni UPDATE (WHERE currentStock = snapshot) — ista TOCTOU-
// bezbedna tehnika kao billing/void/transfer guard-ovi svuda drugde u ovom
// projektu, ne "SELECT pa posle UPDATE" (što bi ostavilo race prozor).
// Ako se zaliha promenila u međuvremenu (npr. konkurentna prodaja/prijem
// robe), red se označava STALE i NE upisuje se korekcija — normalan
// menadžer mora "Prebroj ponovo" (recountLine), OWNER/ADMIN sme eksplicitno
// da pређe preko upozorenja (override), i tada se korekcija računa NASUPROT
// SVEŽE pročitane žive vrednosti, nikad naslepo physicalQty upisano preko
// stare pretpostavke.
//
// Potvrda cele sesije je JEDNA atomska transakcija — ako BILO KOJI red
// naiđe na nerešen STALE, CELA transakcija se poništava (nijedan drugi red
// iz iste potvrde ne ostaje delimično upisan), zahtev specifikacije "no
// partial confirmation".
// ─────────────────────────────────────────────────────────────────────────

enum InventoryCountStatus {
  OPEN
  CONFIRMED
}

enum InventoryCountTargetType {
  INGREDIENT
  MENU_ITEM
}

enum InventoryCountLineStatus {
  NOT_COUNTED // Nije prebrojano
  MATCH // Poklapa se
  SHORTAGE // Manjak
  SURPLUS // Višak
  STALE // Stanje promenjeno tokom inventure
}

model InventoryCountSession {
  id           String               @id @default(uuid())
  restaurantId String
  locationId   String
  status       InventoryCountStatus @default(OPEN)
  startedBy    String
  startedAt    DateTime             @default(now())
  confirmedBy  String?
  confirmedAt  DateTime?

  lines InventoryCountLine[]

  @@index([restaurantId])
  @@index([locationId])
  @@index([restaurantId, locationId, status])
  @@map("inventory_count_sessions")
}

model InventoryCountLine {
  id           String                   @id @default(uuid())
  sessionId    String
  targetType   InventoryCountTargetType
  // Plain — vidi napomenu na vrhu MenuItemAvailability o istoj konvenciji;
  // imena artikala/sirovina se za prikaz batch-uju posebnim upitom (isti
  // obrazac kao resolveEmployeeDisplayNames), ne kroz Prisma include.
  ingredientId String?
  menuItemId   String?

  systemQtySnapshot    Decimal                  @db.Decimal(12, 3)
  physicalQty          Decimal?                 @db.Decimal(12, 3)
  status               InventoryCountLineStatus @default(NOT_COUNTED)
  countedBy            String?
  countedAt            DateTime?
  // Popunjeno TEK pri potvrdi sesije, samo za redove sa stvarnom (nenultom)
  // korekcijom — vidi InventoryMovement/IngredientMovement referenceType/
  // referenceId (referenceType="INVENTORY_COUNT", referenceId=sessionId) za
  // punu, upitljivu sledljivost; ovo polje je čisto UI pogodnost (izbegava
  // dodatni join po redu na istorijskom pregledu sesije).
  correctionMovementId String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  session InventoryCountSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([ingredientId])
  @@index([menuItemId])
  @@map("inventory_count_lines")
}
